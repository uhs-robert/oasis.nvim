# extras/zathura/oasis_mirage_dark.zathurarc
## name: Oasis Mirage Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#21333B"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#111C22"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#18252A"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#18252A"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(194,142,255,0.5)"
set highlight-fg                 "#111C22"

# Index (the toggle_index file listing)
set index-bg                     "#111C22"
set index-fg                     "#F5F5DC"
set index-active-bg              "#21333B"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#111C22"
set render-loading-fg            "#587270"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FFA34D"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#111C22"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#21333B"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#18252A"
set completion-group-fg          "#69C3AA"

# Notifications
set notification-bg              "#18252A"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#18252A"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#18252A"
set notification-warning-fg      "#FFA34D"
