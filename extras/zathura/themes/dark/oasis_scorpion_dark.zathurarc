# extras/zathura/oasis_scorpion_dark.zathurarc
## name: Oasis Scorpion Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#1A0500"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#1A0500"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#27120C"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#27120C"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(173,199,107,0.5)"
set highlight-fg                 "#1A0500"

# Index (the toggle_index file listing)
set index-bg                     "#1A0500"
set index-fg                     "#F5F5DC"
set index-active-bg              "#5A3824"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#1A0500"
set render-loading-fg            "#9A6F66"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FF9633"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#1A0500"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#5A3824"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#27120C"
set completion-group-fg          "#F7997D"

# Notifications
set notification-bg              "#27120C"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#27120C"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#27120C"
set notification-warning-fg      "#FF9633"
