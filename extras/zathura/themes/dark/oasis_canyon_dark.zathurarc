# extras/zathura/oasis_canyon_dark.zathurarc
## name: Oasis Canyon Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#261612"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#261612"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#35231D"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#35231D"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "#666666"
set highlight-active-color       "#ADC76B"

# Completion
set completion-bg                "#261612"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#483228"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#35231D"
set completion-group-fg          "#F9AF96"

# Notifications
set notification-bg              "#35231D"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#35231D"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#35231D"
set notification-warning-fg      "#FFC43D"
