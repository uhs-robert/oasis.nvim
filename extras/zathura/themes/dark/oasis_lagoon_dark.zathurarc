# extras/zathura/oasis_lagoon_dark.zathurarc
## name: Oasis Lagoon Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#101825"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#101825"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#1A283F"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#1A283F"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(249,160,94,0.5)"
set highlight-fg                 "#101825"

# Index (the toggle_index file listing)
set index-bg                     "#101825"
set index-fg                     "#F5F5DC"
set index-active-bg              "#22385C"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#101825"
set render-loading-fg            "#3B6A87"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FFA34D"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#101825"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#22385C"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#1A283F"
set completion-group-fg          "#71B8FF"

# Notifications
set notification-bg              "#1A283F"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#1A283F"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#1A283F"
set notification-warning-fg      "#FFA34D"
