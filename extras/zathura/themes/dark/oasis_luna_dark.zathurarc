# extras/zathura/oasis_luna_dark.zathurarc
## name: Oasis Luna Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#0D0D2B"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#0D0D2B"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#17143E"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#17143E"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "#666666"
set highlight-active-color       "#ADC76B"

# Completion
set completion-bg                "#0D0D2B"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#433F38"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#17143E"
set completion-group-fg          "#F0E68C"

# Notifications
set notification-bg              "#17143E"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#17143E"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#17143E"
set notification-warning-fg      "#FF9633"
