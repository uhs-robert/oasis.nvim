# extras/zathura/oasis_rose_dark.zathurarc
## name: Oasis Rose Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#2C1724"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#2C1724"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#3C2534"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#3C2534"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(127,207,120,0.5)"
set highlight-fg                 "#2C1724"

# Index (the toggle_index file listing)
set index-bg                     "#2C1724"
set index-fg                     "#F5F5DC"
set index-active-bg              "#4E3747"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#2C1724"
set render-loading-fg            "#816175"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FF9633"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#2C1724"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#4E3747"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#3C2534"
set completion-group-fg          "#E6A4BE"

# Notifications
set notification-bg              "#3C2534"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#3C2534"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#3C2534"
set notification-warning-fg      "#FF9633"
