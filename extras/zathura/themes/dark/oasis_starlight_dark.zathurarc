# extras/zathura/oasis_starlight_dark.zathurarc
## name: Oasis Starlight Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#000000"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#000000"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#0C131C"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#0C131C"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(240,230,140,0.5)"
set highlight-fg                 "#000000"

# Index (the toggle_index file listing)
set index-bg                     "#000000"
set index-fg                     "#F5F5DC"
set index-active-bg              "#4D4528"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#000000"
set render-loading-fg            "#4F5B6B"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FF9633"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#000000"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#4D4528"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#0C131C"
set completion-group-fg          "#5BADFF"

# Notifications
set notification-bg              "#0C131C"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#0C131C"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#0C131C"
set notification-warning-fg      "#FF9633"
