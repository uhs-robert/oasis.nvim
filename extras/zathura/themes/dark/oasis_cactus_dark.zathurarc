# extras/zathura/oasis_cactus_dark.zathurarc
## name: Oasis Cactus Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#151E17"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#151E17"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#212C22"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#212C22"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(194,142,255,0.5)"
set highlight-fg                 "#151E17"

# Index (the toggle_index file listing)
set index-bg                     "#151E17"
set index-fg                     "#F5F5DC"
set index-active-bg              "#2F3D33"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#151E17"
set render-loading-fg            "#5B7360"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FF9633"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#151E17"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#2F3D33"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#212C22"
set completion-group-fg          "#7FBB82"

# Notifications
set notification-bg              "#212C22"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#212C22"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#212C22"
set notification-warning-fg      "#FF9633"
