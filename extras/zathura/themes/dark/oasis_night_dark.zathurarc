# extras/zathura/oasis_night_dark.zathurarc
## name: Oasis Night Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#08111C"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#08111C"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#101C2D"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#101C2D"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "#666666"
set highlight-active-color       "#CDC673"

# Completion
set completion-bg                "#08111C"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#24364D"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#101C2D"
set completion-group-fg          "#7FA3C9"

# Notifications
set notification-bg              "#101C2D"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#101C2D"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#101C2D"
set notification-warning-fg      "#FF9633"
