# extras/zathura/oasis_dune_dark.zathurarc
## name: Oasis Dune Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#27211B"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#27211B"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#322A24"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#322A24"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(173,199,107,0.5)"
set highlight-fg                 "#27211B"

# Index (the toggle_index file listing)
set index-bg                     "#27211B"
set index-fg                     "#F5F5DC"
set index-active-bg              "#463E34"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#27211B"
set render-loading-fg            "#826D5A"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FFA34D"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#27211B"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#463E34"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#322A24"
set completion-group-fg          "#D8CF7F"

# Notifications
set notification-bg              "#322A24"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#322A24"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#322A24"
set notification-warning-fg      "#FFA34D"
