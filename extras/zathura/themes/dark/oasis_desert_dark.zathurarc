# extras/zathura/oasis_desert_dark.zathurarc
## name: Oasis Desert Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#404040"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#262626"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#2E2E2E"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#2E2E2E"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(173,199,107,0.5)"
set highlight-fg                 "#262626"

# Index (the toggle_index file listing)
set index-bg                     "#262626"
set index-fg                     "#F5F5DC"
set index-active-bg              "#433F38"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#262626"
set render-loading-fg            "#77725F"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FFA34D"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#262626"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#433F38"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#2E2E2E"
set completion-group-fg          "#F0E68C"

# Notifications
set notification-bg              "#2E2E2E"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#2E2E2E"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#2E2E2E"
set notification-warning-fg      "#FFA34D"
