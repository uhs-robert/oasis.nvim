# extras/zathura/oasis_midnight_dark.zathurarc
## name: Oasis Midnight Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#0C0E13"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#0C0E13"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#141C24"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#141C24"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "#666666"
set highlight-active-color       "#ADC76B"

# Completion
set completion-bg                "#0C0E13"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#1E2A38"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#141C24"
set completion-group-fg          "#FF7979"

# Notifications
set notification-bg              "#141C24"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#141C24"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#141C24"
set notification-warning-fg      "#FFA34D"
