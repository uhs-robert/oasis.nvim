# extras/zathura/oasis_twilight_dark.zathurarc
## name: Oasis Twilight Dark
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#362343"
set recolor-darkcolor            "#F5F5DC"

# Chrome
set default-bg                   "#1B1320"
set default-fg                   "#F5F5DC"
set statusbar-bg                 "#261A32"
set statusbar-fg                 "#F5F5DC"
set inputbar-bg                  "#261A32"
set inputbar-fg                  "#FFFFF0"

# Search
set highlight-color              "rgba(102,102,102,0.4)"
set highlight-active-color       "rgba(247,153,125,0.5)"
set highlight-fg                 "#1B1320"

# Index (the toggle_index file listing)
set index-bg                     "#1B1320"
set index-fg                     "#F5F5DC"
set index-active-bg              "#362343"
set index-active-fg              "#FFFFF0"

# Render placeholder
set render-loading-bg            "#1B1320"
set render-loading-fg            "#71609A"

# Signatures
set signature-success-color      "#87CEEB"
set signature-warning-color      "#FF9633"
set signature-error-color        "#FF7979"

# Completion
set completion-bg                "#1B1320"
set completion-fg                "#F5F5DC"
set completion-highlight-bg      "#362343"
set completion-highlight-fg      "#FFFFF0"
set completion-group-bg          "#261A32"
set completion-group-fg          "#F7997D"

# Notifications
set notification-bg              "#261A32"
set notification-fg              "#F5F5DC"
set notification-error-bg        "#261A32"
set notification-error-fg        "#FF7979"
set notification-warning-bg      "#261A32"
set notification-warning-fg      "#FF9633"
