# extras/zathura/oasis_sol_light_4.zathurarc
## name: Oasis Sol Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#efb7b7"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#efb7b7"
set default-fg                   "#181811"
set statusbar-bg                 "#eba4a4"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#eba4a4"
set inputbar-fg                  "#252512"

# Search
set highlight-color              "rgba(225,157,157,0.4)"
set highlight-active-color       "rgba(122,209,167,0.5)"
set highlight-fg                 "#0d311f"

# Index (the toggle_index file listing)
set index-bg                     "#efb7b7"
set index-fg                     "#181811"
set index-active-bg              "#e48585"
set index-active-fg              "#252512"

# Render placeholder
set render-loading-bg            "#efb7b7"
set render-loading-fg            "#5d4f4d"

# Signatures
set signature-success-color      "#1f3f4c"
set signature-warning-color      "#76471d"
set signature-error-color        "#563e09"

# Completion
set completion-bg                "#efb7b7"
set completion-fg                "#181811"
set completion-highlight-bg      "#e48585"
set completion-highlight-fg      "#252512"
set completion-group-bg          "#eba4a4"
set completion-group-fg          "#842020"

# Notifications
set notification-bg              "#eba4a4"
set notification-fg              "#181811"
set notification-error-bg        "#eba4a4"
set notification-error-fg        "#563e09"
set notification-warning-bg      "#eba4a4"
set notification-warning-fg      "#76471d"
