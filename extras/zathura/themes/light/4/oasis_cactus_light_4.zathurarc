# extras/zathura/oasis_cactus_light_4.zathurarc
## name: Oasis Cactus Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#a8d7ba"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#d2eadb"
set default-fg                   "#181811"
set statusbar-bg                 "#c2e3ce"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#c2e3ce"
set inputbar-fg                  "#3b3b1e"

# Search
set highlight-color              "rgba(164,218,192,0.4)"
set highlight-active-color       "rgba(188,118,214,0.5)"
set highlight-fg                 "#280b32"

# Index (the toggle_index file listing)
set index-bg                     "#d2eadb"
set index-fg                     "#181811"
set index-active-bg              "#a8d7ba"
set index-active-fg              "#3b3b1e"

# Render placeholder
set render-loading-bg            "#d2eadb"
set render-loading-fg            "#5e6960"

# Signatures
set signature-success-color      "#2a5465"
set signature-warning-color      "#925923"
set signature-error-color        "#ac1318"

# Completion
set completion-bg                "#d2eadb"
set completion-fg                "#181811"
set completion-highlight-bg      "#a8d7ba"
set completion-highlight-fg      "#3b3b1e"
set completion-group-bg          "#c2e3ce"
set completion-group-fg          "#475f48"

# Notifications
set notification-bg              "#c2e3ce"
set notification-fg              "#181811"
set notification-error-bg        "#c2e3ce"
set notification-error-fg        "#ac1318"
set notification-warning-bg      "#c2e3ce"
set notification-warning-fg      "#925923"
