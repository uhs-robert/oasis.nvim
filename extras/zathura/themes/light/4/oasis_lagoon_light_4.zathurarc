# extras/zathura/oasis_lagoon_light_4.zathurarc
## name: Oasis Lagoon Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#cfe2f8"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#cfe2f8"
set default-fg                   "#181811"
set statusbar-bg                 "#bbd6f5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#bbd6f5"
set inputbar-fg                  "#38381c"

# Search
set highlight-color              "#9fcae0"
set highlight-active-color       "#dd986f"

# Completion
set completion-bg                "#cfe2f8"
set completion-fg                "#181811"
set completion-highlight-bg      "#9ac2f0"
set completion-highlight-fg      "#38381c"
set completion-group-bg          "#bbd6f5"
set completion-group-fg          "#24598d"

# Notifications
set notification-bg              "#bbd6f5"
set notification-fg              "#181811"
set notification-error-bg        "#bbd6f5"
set notification-error-fg        "#a71218"
set notification-warning-bg      "#bbd6f5"
set notification-warning-fg      "#8f5623"
