# extras/zathura/oasis_lagoon_light_4.zathurarc
## name: Oasis Lagoon Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#9ac2f0"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#cfe2f8"
set default-fg                   "#181811"
set statusbar-bg                 "#bbd6f5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#bbd6f5"
set inputbar-fg                  "#38381c"

# Search
set highlight-color              "rgba(159,202,224,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#cfe2f8"
set index-fg                     "#181811"
set index-active-bg              "#9ac2f0"
set index-active-fg              "#38381c"

# Render placeholder
set render-loading-bg            "#cfe2f8"
set render-loading-fg            "#546672"

# Signatures
set signature-success-color      "#285162"
set signature-warning-color      "#8f5623"
set signature-error-color        "#a71218"

# Completion
set completion-bg                "#cfe2f8"
set completion-fg                "#181811"
set completion-highlight-bg      "#9ac2f0"
set completion-highlight-fg      "#38381c"
set completion-group-bg          "#bbd6f5"
set completion-group-fg          "#24598d"

# Notifications
set notification-bg              "#bbd6f5"
set notification-fg              "#181811"
set notification-error-bg        "#bbd6f5"
set notification-error-fg        "#a71218"
set notification-warning-bg      "#bbd6f5"
set notification-warning-fg      "#8f5623"
