# extras/zathura/oasis_desert_light_4.zathurarc
## name: Oasis Desert Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#e4d592"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f0e8c3"
set default-fg                   "#181811"
set statusbar-bg                 "#ebe1b1"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#ebe1b1"
set inputbar-fg                  "#3d3d1f"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#f0e8c3"
set index-fg                     "#181811"
set index-active-bg              "#e4d592"
set index-active-fg              "#3d3d1f"

# Render placeholder
set render-loading-bg            "#f0e8c3"
set render-loading-fg            "#6a6860"

# Signatures
set signature-success-color      "#2b5668"
set signature-warning-color      "#955a24"
set signature-error-color        "#af1319"

# Completion
set completion-bg                "#f0e8c3"
set completion-fg                "#181811"
set completion-highlight-bg      "#e4d592"
set completion-highlight-fg      "#3d3d1f"
set completion-group-bg          "#ebe1b1"
set completion-group-fg          "#615d2c"

# Notifications
set notification-bg              "#ebe1b1"
set notification-fg              "#181811"
set notification-error-bg        "#ebe1b1"
set notification-error-fg        "#af1319"
set notification-warning-bg      "#ebe1b1"
set notification-warning-fg      "#955a24"
