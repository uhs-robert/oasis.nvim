# extras/zathura/oasis_dune_light_4.zathurarc
## name: Oasis Dune Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#ecc793"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f5e2c7"
set default-fg                   "#181811"
set statusbar-bg                 "#f2d8b4"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#f2d8b4"
set inputbar-fg                  "#3b3b1e"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#f5e2c7"
set index-fg                     "#181811"
set index-active-bg              "#ecc793"
set index-active-fg              "#3b3b1e"

# Render placeholder
set render-loading-bg            "#f5e2c7"
set render-loading-fg            "#6f655c"

# Signatures
set signature-success-color      "#2a5465"
set signature-warning-color      "#935924"
set signature-error-color        "#ac1318"

# Completion
set completion-bg                "#f5e2c7"
set completion-fg                "#181811"
set completion-highlight-bg      "#ecc793"
set completion-highlight-fg      "#3b3b1e"
set completion-group-bg          "#f2d8b4"
set completion-group-fg          "#5e5b37"

# Notifications
set notification-bg              "#f2d8b4"
set notification-fg              "#181811"
set notification-error-bg        "#f2d8b4"
set notification-error-fg        "#ac1318"
set notification-warning-bg      "#f2d8b4"
set notification-warning-fg      "#935924"
