# extras/zathura/oasis_mirage_light_4.zathurarc
## name: Oasis Mirage Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#cdeeea"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#cdeeea"
set default-fg                   "#181811"
set statusbar-bg                 "#bce8e3"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#bce8e3"
set inputbar-fg                  "#3d3d1f"

# Search
set highlight-color              "rgba(159,224,215,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#cdeeea"
set index-fg                     "#181811"
set index-active-bg              "#9fded7"
set index-active-fg              "#3d3d1f"

# Render placeholder
set render-loading-bg            "#cdeeea"
set render-loading-fg            "#5e6b6a"

# Signatures
set signature-success-color      "#2b5567"
set signature-warning-color      "#955a24"
set signature-error-color        "#af1319"

# Completion
set completion-bg                "#cdeeea"
set completion-fg                "#181811"
set completion-highlight-bg      "#9fded7"
set completion-highlight-fg      "#3d3d1f"
set completion-group-bg          "#bce8e3"
set completion-group-fg          "#3f6259"

# Notifications
set notification-bg              "#bce8e3"
set notification-fg              "#181811"
set notification-error-bg        "#bce8e3"
set notification-error-fg        "#af1319"
set notification-warning-bg      "#bce8e3"
set notification-warning-fg      "#955a24"
