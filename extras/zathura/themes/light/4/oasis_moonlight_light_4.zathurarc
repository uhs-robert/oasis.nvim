# extras/zathura/oasis_moonlight_light_4.zathurarc
## name: Oasis Moonlight Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#cbc6a8"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e2dfce"
set default-fg                   "#181811"
set statusbar-bg                 "#d9d6c0"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d9d6c0"
set inputbar-fg                  "#38381c"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#e2dfce"
set index-fg                     "#181811"
set index-active-bg              "#cbc6a8"
set index-active-fg              "#38381c"

# Render placeholder
set render-loading-bg            "#e2dfce"
set render-loading-fg            "#5b646c"

# Signatures
set signature-success-color      "#285061"
set signature-warning-color      "#8d5622"
set signature-error-color        "#a51217"

# Completion
set completion-bg                "#e2dfce"
set completion-fg                "#181811"
set completion-highlight-bg      "#cbc6a8"
set completion-highlight-fg      "#38381c"
set completion-group-bg          "#d9d6c0"
set completion-group-fg          "#42586e"

# Notifications
set notification-bg              "#d9d6c0"
set notification-fg              "#181811"
set notification-error-bg        "#d9d6c0"
set notification-error-fg        "#a51217"
set notification-warning-bg      "#d9d6c0"
set notification-warning-fg      "#8d5622"
