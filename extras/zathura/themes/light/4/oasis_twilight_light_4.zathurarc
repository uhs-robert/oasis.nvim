# extras/zathura/oasis_twilight_light_4.zathurarc
## name: Oasis Twilight Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#e3d4f0"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e3d4f0"
set default-fg                   "#181811"
set statusbar-bg                 "#d8c3ea"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d8c3ea"
set inputbar-fg                  "#34341a"

# Search
set highlight-color              "#e1b69d"
set highlight-active-color       "#dd6f6f"

# Completion
set completion-bg                "#e3d4f0"
set completion-fg                "#181811"
set completion-highlight-bg      "#c5a7e0"
set completion-highlight-fg      "#34341a"
set completion-group-bg          "#d8c3ea"
set completion-group-fg          "#863d28"

# Notifications
set notification-bg              "#d8c3ea"
set notification-fg              "#181811"
set notification-error-bg        "#d8c3ea"
set notification-error-fg        "#9f1117"
set notification-warning-bg      "#d8c3ea"
set notification-warning-fg      "#895321"
