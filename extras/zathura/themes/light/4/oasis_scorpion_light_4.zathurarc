# extras/zathura/oasis_scorpion_light_4.zathurarc
## name: Oasis Scorpion Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#e99c82"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f2c5b6"
set default-fg                   "#181811"
set statusbar-bg                 "#efb6a3"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#efb6a3"
set inputbar-fg                  "#2d2d16"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#f2c5b6"
set index-fg                     "#181811"
set index-active-bg              "#e99c82"
set index-active-fg              "#2d2d16"

# Render placeholder
set render-loading-bg            "#f2c5b6"
set render-loading-fg            "#635653"

# Signatures
set signature-success-color      "#234654"
set signature-warning-color      "#7f4d1f"
set signature-error-color        "#931015"

# Completion
set completion-bg                "#f2c5b6"
set completion-fg                "#181811"
set completion-highlight-bg      "#e99c82"
set completion-highlight-fg      "#2d2d16"
set completion-group-bg          "#efb6a3"
set completion-group-fg          "#7b3825"

# Notifications
set notification-bg              "#efb6a3"
set notification-fg              "#181811"
set notification-error-bg        "#efb6a3"
set notification-error-fg        "#931015"
set notification-warning-bg      "#efb6a3"
set notification-warning-fg      "#7f4d1f"
