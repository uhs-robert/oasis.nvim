# extras/zathura/oasis_scorpion_light_4.zathurarc
## name: Oasis Scorpion Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f2c5b6"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f2c5b6"
set default-fg                   "#181811"
set statusbar-bg                 "#efb6a3"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#efb6a3"
set inputbar-fg                  "#2d2d16"

# Search
set highlight-color              "#e1b69d"
set highlight-active-color       "#b9d17a"

# Completion
set completion-bg                "#f2c5b6"
set completion-fg                "#181811"
set completion-highlight-bg      "#e99c82"
set completion-highlight-fg      "#2d2d16"
set completion-group-bg          "#efb6a3"
set completion-group-fg          "#7b3825"

# Notifications
set notification-bg              "#efb6a3"
set notification-fg              "#181811"
set notification-error-bg        "#efb6a3"
set notification-error-fg        "#931015"
set notification-warning-bg      "#efb6a3"
set notification-warning-fg      "#7f4d1f"
