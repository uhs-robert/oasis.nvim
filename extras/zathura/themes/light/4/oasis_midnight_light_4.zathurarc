# extras/zathura/oasis_midnight_light_4.zathurarc
## name: Oasis Midnight Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#a9b5cb"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#cfd6e2"
set default-fg                   "#181811"
set statusbar-bg                 "#c1cad9"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#c1cad9"
set inputbar-fg                  "#313119"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#cfd6e2"
set index-fg                     "#181811"
set index-active-bg              "#a9b5cb"
set index-active-fg              "#313119"

# Render placeholder
set render-loading-bg            "#cfd6e2"
set render-loading-fg            "#565e65"

# Signatures
set signature-success-color      "#254a5a"
set signature-warning-color      "#855120"
set signature-error-color        "#9b1116"

# Completion
set completion-bg                "#cfd6e2"
set completion-fg                "#181811"
set completion-highlight-bg      "#a9b5cb"
set completion-highlight-fg      "#313119"
set completion-group-bg          "#c1cad9"
set completion-group-fg          "#972525"

# Notifications
set notification-bg              "#c1cad9"
set notification-fg              "#181811"
set notification-error-bg        "#c1cad9"
set notification-error-fg        "#9b1116"
set notification-warning-bg      "#c1cad9"
set notification-warning-fg      "#855120"
