# extras/zathura/oasis_luna_light_4.zathurarc
## name: Oasis Luna Light 4
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#d6d4f5"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#d6d4f5"
set default-fg                   "#181811"
set statusbar-bg                 "#c4c1f1"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#c4c1f1"
set inputbar-fg                  "#333319"

# Search
set highlight-color              "#c3a1dd"
set highlight-active-color       "#d1be7a"

# Completion
set completion-bg                "#d6d4f5"
set completion-fg                "#181811"
set completion-highlight-bg      "#a7a2e9"
set completion-highlight-fg      "#333319"
set completion-group-bg          "#c4c1f1"
set completion-group-fg          "#575327"

# Notifications
set notification-bg              "#c4c1f1"
set notification-fg              "#181811"
set notification-error-bg        "#c4c1f1"
set notification-error-fg        "#9d1116"
set notification-warning-bg      "#c4c1f1"
set notification-warning-fg      "#875221"
