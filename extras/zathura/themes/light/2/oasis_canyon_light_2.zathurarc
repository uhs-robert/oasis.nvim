# extras/zathura/oasis_canyon_light_2.zathurarc
## name: Oasis Canyon Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f1dbc9"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f1dbc9"
set default-fg                   "#181811"
set statusbar-bg                 "#eccfb7"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#eccfb7"
set inputbar-fg                  "#38381c"

# Search
set highlight-color              "#e1b69d"
set highlight-active-color       "#72aeda"

# Completion
set completion-bg                "#f1dbc9"
set completion-fg                "#181811"
set completion-highlight-bg      "#e4bb98"
set completion-highlight-fg      "#38381c"
set completion-group-bg          "#eccfb7"
set completion-group-fg          "#8a4128"

# Notifications
set notification-bg              "#eccfb7"
set notification-fg              "#181811"
set notification-error-bg        "#eccfb7"
set notification-error-fg        "#a61218"
set notification-warning-bg      "#eccfb7"
set notification-warning-fg      "#78602a"
