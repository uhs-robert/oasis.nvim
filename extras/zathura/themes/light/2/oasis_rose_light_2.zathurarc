# extras/zathura/oasis_rose_light_2.zathurarc
## name: Oasis Rose Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f6e2ef"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f6e2ef"
set default-fg                   "#181811"
set statusbar-bg                 "#f1d0e5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#f1d0e5"
set inputbar-fg                  "#3d3d1f"

# Search
set highlight-color              "#dba3c6"
set highlight-active-color       "#72dacc"

# Completion
set completion-bg                "#f6e2ef"
set completion-fg                "#181811"
set completion-highlight-bg      "#e8b3d5"
set completion-highlight-fg      "#3d3d1f"
set completion-group-bg          "#f1d0e5"
set completion-group-fg          "#844960"

# Notifications
set notification-bg              "#f1d0e5"
set notification-fg              "#181811"
set notification-error-bg        "#f1d0e5"
set notification-error-fg        "#af131a"
set notification-warning-bg      "#f1d0e5"
set notification-warning-fg      "#955b23"
