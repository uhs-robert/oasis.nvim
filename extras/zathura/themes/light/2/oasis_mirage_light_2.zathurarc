# extras/zathura/oasis_mirage_light_2.zathurarc
## name: Oasis Mirage Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#e3f6f4"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e3f6f4"
set default-fg                   "#181811"
set statusbar-bg                 "#d2f0ed"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d2f0ed"
set inputbar-fg                  "#434322"

# Search
set highlight-color              "#9fe0d7"
set highlight-active-color       "#dd986f"

# Completion
set completion-bg                "#e3f6f4"
set completion-fg                "#181811"
set completion-highlight-bg      "#b5e7e2"
set completion-highlight-fg      "#434322"
set completion-group-bg          "#d2f0ed"
set completion-group-fg          "#44695f"

# Notifications
set notification-bg              "#d2f0ed"
set notification-fg              "#181811"
set notification-error-bg        "#d2f0ed"
set notification-error-fg        "#bb141b"
set notification-warning-bg      "#d2f0ed"
set notification-warning-fg      "#9e6025"
