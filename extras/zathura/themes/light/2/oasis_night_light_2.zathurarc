# extras/zathura/oasis_night_light_2.zathurarc
## name: Oasis Night Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#b4cfe9"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e4edf7"
set default-fg                   "#181811"
set statusbar-bg                 "#d2e2f1"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d2e2f1"
set inputbar-fg                  "#404021"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#e4edf7"
set index-fg                     "#181811"
set index-active-bg              "#b4cfe9"
set index-active-fg              "#404021"

# Render placeholder
set render-loading-bg            "#e4edf7"
set render-loading-fg            "#626d76"

# Signatures
set signature-success-color      "#2c596b"
set signature-warning-color      "#995d24"
set signature-error-color        "#b4141a"

# Completion
set completion-bg                "#e4edf7"
set completion-fg                "#181811"
set completion-highlight-bg      "#b4cfe9"
set completion-highlight-fg      "#404021"
set completion-group-bg          "#d2e2f1"
set completion-group-fg          "#496078"

# Notifications
set notification-bg              "#d2e2f1"
set notification-fg              "#181811"
set notification-error-bg        "#d2e2f1"
set notification-error-fg        "#b4141a"
set notification-warning-bg      "#d2e2f1"
set notification-warning-fg      "#995d24"
