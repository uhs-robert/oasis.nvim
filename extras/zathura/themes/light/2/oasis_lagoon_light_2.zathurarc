# extras/zathura/oasis_lagoon_light_2.zathurarc
## name: Oasis Lagoon Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#b3d2f5"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e9f2fc"
set default-fg                   "#181811"
set statusbar-bg                 "#d5e6f9"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d5e6f9"
set inputbar-fg                  "#434322"

# Search
set highlight-color              "rgba(159,202,224,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#e9f2fc"
set index-fg                     "#181811"
set index-active-bg              "#b3d2f5"
set index-active-fg              "#434322"

# Render placeholder
set render-loading-bg            "#e9f2fc"
set render-loading-fg            "#5c717e"

# Signatures
set signature-success-color      "#2e5c6e"
set signature-warning-color      "#9d6025"
set signature-error-color        "#ba141b"

# Completion
set completion-bg                "#e9f2fc"
set completion-fg                "#181811"
set completion-highlight-bg      "#b3d2f5"
set completion-highlight-fg      "#434322"
set completion-group-bg          "#d5e6f9"
set completion-group-fg          "#2a639e"

# Notifications
set notification-bg              "#d5e6f9"
set notification-fg              "#181811"
set notification-error-bg        "#d5e6f9"
set notification-error-fg        "#ba141b"
set notification-warning-bg      "#d5e6f9"
set notification-warning-fg      "#9d6025"
