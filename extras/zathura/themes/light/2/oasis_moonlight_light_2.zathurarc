# extras/zathura/oasis_moonlight_light_2.zathurarc
## name: Oasis Moonlight Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#eeebe2"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#eeebe2"
set default-fg                   "#181811"
set statusbar-bg                 "#e6e1d4"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#e6e1d4"
set inputbar-fg                  "#3f3f20"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#eeebe2"
set index-fg                     "#181811"
set index-active-bg              "#d7d0bb"
set index-active-fg              "#3f3f20"

# Render placeholder
set render-loading-bg            "#eeebe2"
set render-loading-fg            "#636c74"

# Signatures
set signature-success-color      "#2c586a"
set signature-warning-color      "#985d24"
set signature-error-color        "#b3141a"

# Completion
set completion-bg                "#eeebe2"
set completion-fg                "#181811"
set completion-highlight-bg      "#d7d0bb"
set completion-highlight-fg      "#3f3f20"
set completion-group-bg          "#e6e1d4"
set completion-group-fg          "#496078"

# Notifications
set notification-bg              "#e6e1d4"
set notification-fg              "#181811"
set notification-error-bg        "#e6e1d4"
set notification-error-fg        "#b3141a"
set notification-warning-bg      "#e6e1d4"
set notification-warning-fg      "#985d24"
