# extras/zathura/oasis_twilight_light_2.zathurarc
## name: Oasis Twilight Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#d2bce9"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f1eaf8"
set default-fg                   "#181811"
set statusbar-bg                 "#e6d9f2"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#e6d9f2"
set inputbar-fg                  "#404021"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#f1eaf8"
set index-fg                     "#181811"
set index-active-bg              "#d2bce9"
set index-active-fg              "#404021"

# Render placeholder
set render-loading-bg            "#f1eaf8"
set render-loading-fg            "#6e697b"

# Signatures
set signature-success-color      "#2c596b"
set signature-warning-color      "#995d24"
set signature-error-color        "#b5141a"

# Completion
set completion-bg                "#f1eaf8"
set completion-fg                "#181811"
set completion-highlight-bg      "#d2bce9"
set completion-highlight-fg      "#404021"
set completion-group-bg          "#e6d9f2"
set completion-group-fg          "#99452e"

# Notifications
set notification-bg              "#e6d9f2"
set notification-fg              "#181811"
set notification-error-bg        "#e6d9f2"
set notification-error-fg        "#b5141a"
set notification-warning-bg      "#e6d9f2"
set notification-warning-fg      "#995d24"
