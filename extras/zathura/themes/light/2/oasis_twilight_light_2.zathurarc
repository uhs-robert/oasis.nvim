# extras/zathura/oasis_twilight_light_2.zathurarc
## name: Oasis Twilight Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f1eaf8"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f1eaf8"
set default-fg                   "#181811"
set statusbar-bg                 "#e6d9f2"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#e6d9f2"
set inputbar-fg                  "#404021"

# Search
set highlight-color              "#e1b69d"
set highlight-active-color       "#dd6f6f"

# Completion
set completion-bg                "#f1eaf8"
set completion-fg                "#181811"
set completion-highlight-bg      "#d2bce9"
set completion-highlight-fg      "#404021"
set completion-group-bg          "#e6d9f2"
set completion-group-fg          "#99452e"

# Notifications
set notification-bg              "#e6d9f2"
set notification-fg              "#181811"
set notification-error-bg        "#e6d9f2"
set notification-error-fg        "#b5141a"
set notification-warning-bg      "#e6d9f2"
set notification-warning-fg      "#995d24"
