# extras/zathura/oasis_dune_light_2.zathurarc
## name: Oasis Dune Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#efd7ae"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f9f0e1"
set default-fg                   "#181811"
set statusbar-bg                 "#f5e6ce"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#f5e6ce"
set inputbar-fg                  "#434322"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#f9f0e1"
set index-fg                     "#181811"
set index-active-bg              "#efd7ae"
set index-active-fg              "#434322"

# Render placeholder
set render-loading-bg            "#f9f0e1"
set render-loading-fg            "#776c63"

# Signatures
set signature-success-color      "#2e5c6e"
set signature-warning-color      "#9d6025"
set signature-error-color        "#ba141b"

# Completion
set completion-bg                "#f9f0e1"
set completion-fg                "#181811"
set completion-highlight-bg      "#efd7ae"
set completion-highlight-fg      "#434322"
set completion-group-bg          "#f5e6ce"
set completion-group-fg          "#66623c"

# Notifications
set notification-bg              "#f5e6ce"
set notification-fg              "#181811"
set notification-error-bg        "#f5e6ce"
set notification-error-fg        "#ba141b"
set notification-warning-bg      "#f5e6ce"
set notification-warning-fg      "#9d6025"
