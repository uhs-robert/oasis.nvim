# extras/zathura/oasis_starlight_light_2.zathurarc
## name: Oasis Starlight Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#faf8f4"
set recolor-darkcolor            "#1d1d14"

# Chrome
set default-bg                   "#faf8f4"
set default-fg                   "#1d1d14"
set statusbar-bg                 "#f3eee4"
set statusbar-fg                 "#1d1d14"
set inputbar-bg                  "#f3eee4"
set inputbar-fg                  "#474724"

# Search
set highlight-color              "#dacfa4"
set highlight-active-color       "#dd986f"

# Completion
set completion-bg                "#faf8f4"
set completion-fg                "#1d1d14"
set completion-highlight-bg      "#e7ddca"
set completion-highlight-fg      "#474724"
set completion-group-bg          "#f3eee4"
set completion-group-fg          "#2c67a5"

# Notifications
set notification-bg              "#f3eee4"
set notification-fg              "#1d1d14"
set notification-error-bg        "#f3eee4"
set notification-error-fg        "#c2151c"
set notification-warning-bg      "#f3eee4"
set notification-warning-fg      "#a46426"
