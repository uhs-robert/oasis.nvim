# extras/zathura/oasis_starlight_light_2.zathurarc
## name: Oasis Starlight Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#e7ddca"
set recolor-darkcolor            "#1d1d14"

# Chrome
set default-bg                   "#faf8f4"
set default-fg                   "#1d1d14"
set statusbar-bg                 "#f3eee4"
set statusbar-fg                 "#1d1d14"
set inputbar-bg                  "#f3eee4"
set inputbar-fg                  "#474724"

# Search
set highlight-color              "rgba(218,207,164,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#faf8f4"
set index-fg                     "#1d1d14"
set index-active-bg              "#e7ddca"
set index-active-fg              "#474724"

# Render placeholder
set render-loading-bg            "#faf8f4"
set render-loading-fg            "#6c737e"

# Signatures
set signature-success-color      "#306073"
set signature-warning-color      "#a46426"
set signature-error-color        "#c2151c"

# Completion
set completion-bg                "#faf8f4"
set completion-fg                "#1d1d14"
set completion-highlight-bg      "#e7ddca"
set completion-highlight-fg      "#474724"
set completion-group-bg          "#f3eee4"
set completion-group-fg          "#2c67a5"

# Notifications
set notification-bg              "#f3eee4"
set notification-fg              "#1d1d14"
set notification-error-bg        "#f3eee4"
set notification-error-fg        "#c2151c"
set notification-warning-bg      "#f3eee4"
set notification-warning-fg      "#a46426"
