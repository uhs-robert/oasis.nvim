# extras/zathura/oasis_midnight_light_2.zathurarc
## name: Oasis Midnight Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#bdc4d7"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e3e6ee"
set default-fg                   "#181811"
set statusbar-bg                 "#d5d9e5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d5d9e5"
set inputbar-fg                  "#3c3c1f"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#e3e6ee"
set index-fg                     "#181811"
set index-active-bg              "#bdc4d7"
set index-active-fg              "#3c3c1f"

# Render placeholder
set render-loading-bg            "#e3e6ee"
set render-loading-fg            "#606970"

# Signatures
set signature-success-color      "#2a5566"
set signature-warning-color      "#945a23"
set signature-error-color        "#ae1319"

# Completion
set completion-bg                "#e3e6ee"
set completion-fg                "#181811"
set completion-highlight-bg      "#bdc4d7"
set completion-highlight-fg      "#3c3c1f"
set completion-group-bg          "#d5d9e5"
set completion-group-fg          "#ab2828"

# Notifications
set notification-bg              "#d5d9e5"
set notification-fg              "#181811"
set notification-error-bg        "#d5d9e5"
set notification-error-fg        "#ae1319"
set notification-warning-bg      "#d5d9e5"
set notification-warning-fg      "#945a23"
