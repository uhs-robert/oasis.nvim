# extras/zathura/oasis_midnight_light_2.zathurarc
## name: Oasis Midnight Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#e3e6ee"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e3e6ee"
set default-fg                   "#181811"
set statusbar-bg                 "#d5d9e5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d5d9e5"
set inputbar-fg                  "#3c3c1f"

# Search
set highlight-color              "#e1c99d"
set highlight-active-color       "#b9d17a"

# Completion
set completion-bg                "#e3e6ee"
set completion-fg                "#181811"
set completion-highlight-bg      "#bdc4d7"
set completion-highlight-fg      "#3c3c1f"
set completion-group-bg          "#d5d9e5"
set completion-group-fg          "#ab2828"

# Notifications
set notification-bg              "#d5d9e5"
set notification-fg              "#181811"
set notification-error-bg        "#d5d9e5"
set notification-error-fg        "#ae1319"
set notification-warning-bg      "#d5d9e5"
set notification-warning-fg      "#945a23"
