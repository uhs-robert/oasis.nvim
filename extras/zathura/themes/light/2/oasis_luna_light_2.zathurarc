# extras/zathura/oasis_luna_light_2.zathurarc
## name: Oasis Luna Light 2
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#eeecfb"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#eeecfb"
set default-fg                   "#181811"
set statusbar-bg                 "#ddd9f7"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#ddd9f7"
set inputbar-fg                  "#414121"

# Search
set highlight-color              "rgba(195,161,221,0.4)"
set highlight-active-color       "rgba(209,190,122,0.5)"
set highlight-fg                 "#31290d"

# Index (the toggle_index file listing)
set index-bg                     "#eeecfb"
set index-fg                     "#181811"
set index-active-bg              "#c1b9f0"
set index-active-fg              "#414121"

# Render placeholder
set render-loading-bg            "#eeecfb"
set render-loading-fg            "#6d6a7f"

# Signatures
set signature-success-color      "#2d5a6c"
set signature-warning-color      "#9a5e24"
set signature-error-color        "#b6141b"

# Completion
set completion-bg                "#eeecfb"
set completion-fg                "#181811"
set completion-highlight-bg      "#c1b9f0"
set completion-highlight-fg      "#414121"
set completion-group-bg          "#ddd9f7"
set completion-group-fg          "#65602e"

# Notifications
set notification-bg              "#ddd9f7"
set notification-fg              "#181811"
set notification-error-bg        "#ddd9f7"
set notification-error-fg        "#b6141b"
set notification-warning-bg      "#ddd9f7"
set notification-warning-fg      "#9a5e24"
