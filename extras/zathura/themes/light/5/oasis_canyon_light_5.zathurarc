# extras/zathura/oasis_canyon_light_5.zathurarc
## name: Oasis Canyon Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#e8c3a5"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e8c3a5"
set default-fg                   "#181811"
set statusbar-bg                 "#e3b793"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#e3b793"
set inputbar-fg                  "#292915"

# Search
set highlight-color              "#e1b69d"
set highlight-active-color       "#72aeda"

# Completion
set completion-bg                "#e8c3a5"
set completion-fg                "#181811"
set completion-highlight-bg      "#dca374"
set completion-highlight-fg      "#292915"
set completion-group-bg          "#e3b793"
set completion-group-fg          "#753722"

# Notifications
set notification-bg              "#e3b793"
set notification-fg              "#181811"
set notification-error-bg        "#e3b793"
set notification-error-fg        "#8c0f14"
set notification-warning-bg      "#e3b793"
set notification-warning-fg      "#675324"
