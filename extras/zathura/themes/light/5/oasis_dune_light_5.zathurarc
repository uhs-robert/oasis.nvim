# extras/zathura/oasis_dune_light_5.zathurarc
## name: Oasis Dune Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f2dcba"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f2dcba"
set default-fg                   "#181811"
set statusbar-bg                 "#eed2a7"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#eed2a7"
set inputbar-fg                  "#38381d"

# Search
set highlight-color              "#e1c99d"
set highlight-active-color       "#b9d17a"

# Completion
set completion-bg                "#f2dcba"
set completion-fg                "#181811"
set completion-highlight-bg      "#e8c287"
set completion-highlight-fg      "#38381d"
set completion-group-bg          "#eed2a7"
set completion-group-fg          "#5b5736"

# Notifications
set notification-bg              "#eed2a7"
set notification-fg              "#181811"
set notification-error-bg        "#eed2a7"
set notification-error-fg        "#a61218"
set notification-warning-bg      "#eed2a7"
set notification-warning-fg      "#8e5622"
