# extras/zathura/oasis_cactus_light_5.zathurarc
## name: Oasis Cactus Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#9dd2b0"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#c7e5d2"
set default-fg                   "#181811"
set statusbar-bg                 "#b7dec5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#b7dec5"
set inputbar-fg                  "#37371d"

# Search
set highlight-color              "rgba(164,218,192,0.4)"
set highlight-active-color       "rgba(188,118,214,0.5)"
set highlight-fg                 "#280b32"

# Index (the toggle_index file listing)
set index-bg                     "#c7e5d2"
set index-fg                     "#181811"
set index-active-bg              "#9dd2b0"
set index-active-fg              "#37371d"

# Render placeholder
set render-loading-bg            "#c7e5d2"
set render-loading-fg            "#5a655d"

# Signatures
set signature-success-color      "#285061"
set signature-warning-color      "#8d5522"
set signature-error-color        "#a41218"

# Completion
set completion-bg                "#c7e5d2"
set completion-fg                "#181811"
set completion-highlight-bg      "#9dd2b0"
set completion-highlight-fg      "#37371d"
set completion-group-bg          "#b7dec5"
set completion-group-fg          "#445b46"

# Notifications
set notification-bg              "#b7dec5"
set notification-fg              "#181811"
set notification-error-bg        "#b7dec5"
set notification-error-fg        "#a41218"
set notification-warning-bg      "#b7dec5"
set notification-warning-fg      "#8d5522"
