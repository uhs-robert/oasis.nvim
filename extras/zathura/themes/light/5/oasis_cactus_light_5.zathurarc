# extras/zathura/oasis_cactus_light_5.zathurarc
## name: Oasis Cactus Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#c7e5d2"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#c7e5d2"
set default-fg                   "#181811"
set statusbar-bg                 "#b7dec5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#b7dec5"
set inputbar-fg                  "#37371d"

# Search
set highlight-color              "#a4dac0"
set highlight-active-color       "#bc76d6"

# Completion
set completion-bg                "#c7e5d2"
set completion-fg                "#181811"
set completion-highlight-bg      "#9dd2b0"
set completion-highlight-fg      "#37371d"
set completion-group-bg          "#b7dec5"
set completion-group-fg          "#445b46"

# Notifications
set notification-bg              "#b7dec5"
set notification-fg              "#181811"
set notification-error-bg        "#b7dec5"
set notification-error-fg        "#a41218"
set notification-warning-bg      "#b7dec5"
set notification-warning-fg      "#8d5522"
