# extras/zathura/oasis_lagoon_light_5.zathurarc
## name: Oasis Lagoon Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#8cbaee"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#c1daf6"
set default-fg                   "#181811"
set statusbar-bg                 "#adcef3"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#adcef3"
set inputbar-fg                  "#33331a"

# Search
set highlight-color              "rgba(159,202,224,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#c1daf6"
set index-fg                     "#181811"
set index-active-bg              "#8cbaee"
set index-active-fg              "#33331a"

# Render placeholder
set render-loading-bg            "#c1daf6"
set render-loading-fg            "#4f616b"

# Signatures
set signature-success-color      "#264b5b"
set signature-warning-color      "#875221"
set signature-error-color        "#9d1117"

# Completion
set completion-bg                "#c1daf6"
set completion-fg                "#181811"
set completion-highlight-bg      "#8cbaee"
set completion-highlight-fg      "#33331a"
set completion-group-bg          "#adcef3"
set completion-group-fg          "#225485"

# Notifications
set notification-bg              "#adcef3"
set notification-fg              "#181811"
set notification-error-bg        "#adcef3"
set notification-error-fg        "#9d1117"
set notification-warning-bg      "#adcef3"
set notification-warning-fg      "#875221"
