# extras/zathura/oasis_moonlight_light_5.zathurarc
## name: Oasis Moonlight Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#c6be9e"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#ddd8c5"
set default-fg                   "#181811"
set statusbar-bg                 "#d5ceb7"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#d5ceb7"
set inputbar-fg                  "#33331b"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#ddd8c5"
set index-fg                     "#181811"
set index-active-bg              "#c6be9e"
set index-active-fg              "#33331b"

# Render placeholder
set render-loading-bg            "#ddd8c5"
set render-loading-fg            "#576066"

# Signatures
set signature-success-color      "#264c5c"
set signature-warning-color      "#885221"
set signature-error-color        "#9d1117"

# Completion
set completion-bg                "#ddd8c5"
set completion-fg                "#181811"
set completion-highlight-bg      "#c6be9e"
set completion-highlight-fg      "#33331b"
set completion-group-bg          "#d5ceb7"
set completion-group-fg          "#3f5469"

# Notifications
set notification-bg              "#d5ceb7"
set notification-fg              "#181811"
set notification-error-bg        "#d5ceb7"
set notification-error-fg        "#9d1117"
set notification-warning-bg      "#d5ceb7"
set notification-warning-fg      "#885221"
