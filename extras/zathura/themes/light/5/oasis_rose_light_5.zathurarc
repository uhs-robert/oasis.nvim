# extras/zathura/oasis_rose_light_5.zathurarc
## name: Oasis Rose Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#de8fc1"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#ecbedb"
set default-fg                   "#181811"
set statusbar-bg                 "#e7acd1"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#e7acd1"
set inputbar-fg                  "#2a2a16"

# Search
set highlight-color              "rgba(219,163,198,0.4)"
set highlight-active-color       "rgba(114,218,204,0.5)"
set highlight-fg                 "#09342f"

# Index (the toggle_index file listing)
set index-bg                     "#ecbedb"
set index-fg                     "#181811"
set index-active-bg              "#de8fc1"
set index-active-fg              "#2a2a16"

# Render placeholder
set render-loading-bg            "#ecbedb"
set render-loading-fg            "#5f535b"

# Signatures
set signature-success-color      "#224351"
set signature-warning-color      "#7c4b1e"
set signature-error-color        "#8e0f15"

# Completion
set completion-bg                "#ecbedb"
set completion-fg                "#181811"
set completion-highlight-bg      "#de8fc1"
set completion-highlight-fg      "#2a2a16"
set completion-group-bg          "#e7acd1"
set completion-group-fg          "#6a3b4e"

# Notifications
set notification-bg              "#e7acd1"
set notification-fg              "#181811"
set notification-error-bg        "#e7acd1"
set notification-error-fg        "#8e0f15"
set notification-warning-bg      "#e7acd1"
set notification-warning-fg      "#7c4b1e"
