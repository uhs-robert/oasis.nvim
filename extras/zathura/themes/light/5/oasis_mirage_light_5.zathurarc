# extras/zathura/oasis_mirage_light_5.zathurarc
## name: Oasis Mirage Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#c1eae6"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#c1eae6"
set default-fg                   "#181811"
set statusbar-bg                 "#b0e4df"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#b0e4df"
set inputbar-fg                  "#3a3a1e"

# Search
set highlight-color              "#9fe0d7"
set highlight-active-color       "#dd986f"

# Completion
set completion-bg                "#c1eae6"
set completion-fg                "#181811"
set completion-highlight-bg      "#93dbd4"
set completion-highlight-fg      "#3a3a1e"
set completion-group-bg          "#b0e4df"
set completion-group-fg          "#3d5e55"

# Notifications
set notification-bg              "#b0e4df"
set notification-fg              "#181811"
set notification-error-bg        "#b0e4df"
set notification-error-fg        "#a91218"
set notification-warning-bg      "#b0e4df"
set notification-warning-fg      "#905723"
