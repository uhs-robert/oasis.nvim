# extras/zathura/oasis_desert_light_5.zathurarc
## name: Oasis Desert Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#e1d286"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#ede4b7"
set default-fg                   "#181811"
set statusbar-bg                 "#e8dda5"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#e8dda5"
set inputbar-fg                  "#3b3b1e"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#ede4b7"
set index-fg                     "#181811"
set index-active-bg              "#e1d286"
set index-active-fg              "#3b3b1e"

# Render placeholder
set render-loading-bg            "#ede4b7"
set render-loading-fg            "#69665d"

# Signatures
set signature-success-color      "#295365"
set signature-warning-color      "#925823"
set signature-error-color        "#aa1219"

# Completion
set completion-bg                "#ede4b7"
set completion-fg                "#181811"
set completion-highlight-bg      "#e1d286"
set completion-highlight-fg      "#3b3b1e"
set completion-group-bg          "#e8dda5"
set completion-group-fg          "#5f5a2b"

# Notifications
set notification-bg              "#e8dda5"
set notification-fg              "#181811"
set notification-error-bg        "#e8dda5"
set notification-error-fg        "#aa1219"
set notification-warning-bg      "#e8dda5"
set notification-warning-fg      "#925823"
