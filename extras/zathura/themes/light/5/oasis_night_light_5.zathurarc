# extras/zathura/oasis_night_light_5.zathurarc
## name: Oasis Night Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#b7d5f0"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#b7d5f0"
set default-fg                   "#181811"
set statusbar-bg                 "#a4caec"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#a4caec"
set inputbar-fg                  "#2e2e18"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#b7d5f0"
set index-fg                     "#181811"
set index-active-bg              "#84b7e6"
set index-active-fg              "#2e2e18"

# Render placeholder
set render-loading-bg            "#b7d5f0"
set render-loading-fg            "#535b64"

# Signatures
set signature-success-color      "#244757"
set signature-warning-color      "#824e1f"
set signature-error-color        "#951016"

# Completion
set completion-bg                "#b7d5f0"
set completion-fg                "#181811"
set completion-highlight-bg      "#84b7e6"
set completion-highlight-fg      "#2e2e18"
set completion-group-bg          "#a4caec"
set completion-group-fg          "#3c5063"

# Notifications
set notification-bg              "#a4caec"
set notification-fg              "#181811"
set notification-error-bg        "#a4caec"
set notification-error-fg        "#951016"
set notification-warning-bg      "#a4caec"
set notification-warning-fg      "#824e1f"
