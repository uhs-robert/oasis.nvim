# extras/zathura/oasis_midnight_light_5.zathurarc
## name: Oasis Midnight Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#a0acc5"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#c6cddc"
set default-fg                   "#181811"
set statusbar-bg                 "#b8c1d3"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#b8c1d3"
set inputbar-fg                  "#2b2b16"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#c6cddc"
set index-fg                     "#181811"
set index-active-bg              "#a0acc5"
set index-active-fg              "#2b2b16"

# Render placeholder
set render-loading-bg            "#c6cddc"
set render-loading-fg            "#51595f"

# Signatures
set signature-success-color      "#224453"
set signature-warning-color      "#7d4c1e"
set signature-error-color        "#901015"

# Completion
set completion-bg                "#c6cddc"
set completion-fg                "#181811"
set completion-highlight-bg      "#a0acc5"
set completion-highlight-fg      "#2b2b16"
set completion-group-bg          "#b8c1d3"
set completion-group-fg          "#8e2222"

# Notifications
set notification-bg              "#b8c1d3"
set notification-fg              "#181811"
set notification-error-bg        "#b8c1d3"
set notification-error-fg        "#901015"
set notification-warning-bg      "#b8c1d3"
set notification-warning-fg      "#7d4c1e"
