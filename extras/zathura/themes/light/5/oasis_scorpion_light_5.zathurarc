# extras/zathura/oasis_scorpion_light_5.zathurarc
## name: Oasis Scorpion Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#e59175"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#efbaa9"
set default-fg                   "#181811"
set statusbar-bg                 "#ebaa96"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#ebaa96"
set inputbar-fg                  "#262613"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#efbaa9"
set index-fg                     "#181811"
set index-active-bg              "#e59175"
set index-active-fg              "#262613"

# Render placeholder
set render-loading-bg            "#efbaa9"
set render-loading-fg            "#5c504f"

# Signatures
set signature-success-color      "#20404d"
set signature-warning-color      "#77481d"
set signature-error-color        "#880f14"

# Completion
set completion-bg                "#efbaa9"
set completion-fg                "#181811"
set completion-highlight-bg      "#e59175"
set completion-highlight-fg      "#262613"
set completion-group-bg          "#ebaa96"
set completion-group-fg          "#723422"

# Notifications
set notification-bg              "#ebaa96"
set notification-fg              "#181811"
set notification-error-bg        "#ebaa96"
set notification-error-fg        "#880f14"
set notification-warning-bg      "#ebaa96"
set notification-warning-fg      "#77481d"
