# extras/zathura/oasis_scorpion_light_5.zathurarc
## name: Oasis Scorpion Light 5
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#efbaa9"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#efbaa9"
set default-fg                   "#181811"
set statusbar-bg                 "#ebaa96"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#ebaa96"
set inputbar-fg                  "#262613"

# Search
set highlight-color              "#e1b69d"
set highlight-active-color       "#b9d17a"

# Completion
set completion-bg                "#efbaa9"
set completion-fg                "#181811"
set completion-highlight-bg      "#e59175"
set completion-highlight-fg      "#262613"
set completion-group-bg          "#ebaa96"
set completion-group-fg          "#723422"

# Notifications
set notification-bg              "#ebaa96"
set notification-fg              "#181811"
set notification-error-bg        "#ebaa96"
set notification-error-fg        "#880f14"
set notification-warning-bg      "#ebaa96"
set notification-warning-fg      "#77481d"
