# extras/zathura/oasis_dune_light_1.zathurarc
## name: Oasis Dune Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#f3daba"
set recolor-darkcolor            "#1c1c13"

# Chrome
set default-bg                   "#fcf6ee"
set default-fg                   "#1c1c13"
set statusbar-bg                 "#f9ecda"
set statusbar-fg                 "#1c1c13"
set inputbar-bg                  "#f9ecda"
set inputbar-fg                  "#464624"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#fcf6ee"
set index-fg                     "#1c1c13"
set index-active-bg              "#f3daba"
set index-active-fg              "#464624"

# Render placeholder
set render-loading-bg            "#fcf6ee"
set render-loading-fg            "#7a7066"

# Signatures
set signature-success-color      "#305f72"
set signature-warning-color      "#a36226"
set signature-error-color        "#c0151b"

# Completion
set completion-bg                "#fcf6ee"
set completion-fg                "#1c1c13"
set completion-highlight-bg      "#f3daba"
set completion-highlight-fg      "#464624"
set completion-group-bg          "#f9ecda"
set completion-group-fg          "#6a653f"

# Notifications
set notification-bg              "#f9ecda"
set notification-fg              "#1c1c13"
set notification-error-bg        "#f9ecda"
set notification-error-fg        "#c0151b"
set notification-warning-bg      "#f9ecda"
set notification-warning-fg      "#a36226"
