# extras/zathura/oasis_cactus_light_1.zathurarc
## name: Oasis Cactus Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#c6e7d2"
set recolor-darkcolor            "#1c1c13"

# Chrome
set default-bg                   "#f1f9f4"
set default-fg                   "#1c1c13"
set statusbar-bg                 "#e1f2e7"
set statusbar-fg                 "#1c1c13"
set inputbar-bg                  "#e1f2e7"
set inputbar-fg                  "#464624"

# Search
set highlight-color              "rgba(164,218,192,0.4)"
set highlight-active-color       "rgba(188,118,214,0.5)"
set highlight-fg                 "#280b32"

# Index (the toggle_index file listing)
set index-bg                     "#f1f9f4"
set index-fg                     "#1c1c13"
set index-active-bg              "#c6e7d2"
set index-active-fg              "#464624"

# Render placeholder
set render-loading-bg            "#f1f9f4"
set render-loading-fg            "#69756b"

# Signatures
set signature-success-color      "#305f72"
set signature-warning-color      "#a36326"
set signature-error-color        "#c0151b"

# Completion
set completion-bg                "#f1f9f4"
set completion-fg                "#1c1c13"
set completion-highlight-bg      "#c6e7d2"
set completion-highlight-fg      "#464624"
set completion-group-bg          "#e1f2e7"
set completion-group-fg          "#4f6b50"

# Notifications
set notification-bg              "#e1f2e7"
set notification-fg              "#1c1c13"
set notification-error-bg        "#e1f2e7"
set notification-error-fg        "#c0151b"
set notification-warning-bg      "#e1f2e7"
set notification-warning-fg      "#a36326"
