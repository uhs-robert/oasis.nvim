# extras/zathura/oasis_mirage_light_1.zathurarc
## name: Oasis Mirage Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#c0ebe4"
set recolor-darkcolor            "#1c1c14"

# Chrome
set default-bg                   "#effaf8"
set default-fg                   "#1c1c14"
set statusbar-bg                 "#def5f0"
set statusbar-fg                 "#1c1c14"
set inputbar-bg                  "#def5f0"
set inputbar-fg                  "#474724"

# Search
set highlight-color              "rgba(159,224,215,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#effaf8"
set index-fg                     "#1c1c14"
set index-active-bg              "#c0ebe4"
set index-active-fg              "#474724"

# Render placeholder
set render-loading-bg            "#effaf8"
set render-loading-fg            "#677574"

# Signatures
set signature-success-color      "#306073"
set signature-warning-color      "#a36326"
set signature-error-color        "#c1151c"

# Completion
set completion-bg                "#effaf8"
set completion-fg                "#1c1c14"
set completion-highlight-bg      "#c0ebe4"
set completion-highlight-fg      "#474724"
set completion-group-bg          "#def5f0"
set completion-group-fg          "#476c62"

# Notifications
set notification-bg              "#def5f0"
set notification-fg              "#1c1c14"
set notification-error-bg        "#def5f0"
set notification-error-fg        "#c1151c"
set notification-warning-bg      "#def5f0"
set notification-warning-fg      "#a36326"
