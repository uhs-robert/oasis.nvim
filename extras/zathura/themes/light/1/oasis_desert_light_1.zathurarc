# extras/zathura/oasis_desert_light_1.zathurarc
## name: Oasis Desert Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f9f6e7"
set recolor-darkcolor            "#1b1b13"

# Chrome
set default-bg                   "#f9f6e7"
set default-fg                   "#1b1b13"
set statusbar-bg                 "#f4efd5"
set statusbar-fg                 "#1b1b13"
set inputbar-bg                  "#f4efd5"
set inputbar-fg                  "#464623"

# Search
set highlight-color              "#e1c99d"
set highlight-active-color       "#b9d17a"

# Completion
set completion-bg                "#f9f6e7"
set completion-fg                "#1b1b13"
set completion-highlight-bg      "#ede4b6"
set completion-highlight-fg      "#464623"
set completion-group-bg          "#f4efd5"
set completion-group-fg          "#6b6531"

# Notifications
set notification-bg              "#f4efd5"
set notification-fg              "#1b1b13"
set notification-error-bg        "#f4efd5"
set notification-error-fg        "#bf151b"
set notification-warning-bg      "#f4efd5"
set notification-warning-fg      "#a26226"
