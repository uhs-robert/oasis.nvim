# extras/zathura/oasis_scorpion_light_1.zathurarc
## name: Oasis Scorpion Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f9e4dd"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f9e4dd"
set default-fg                   "#181811"
set statusbar-bg                 "#f6d5c9"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#f6d5c9"
set inputbar-fg                  "#3e3e1f"

# Search
set highlight-color              "#e1b69d"
set highlight-active-color       "#b9d17a"

# Completion
set completion-bg                "#f9e4dd"
set completion-fg                "#181811"
set completion-highlight-bg      "#f0bba9"
set completion-highlight-fg      "#3e3e1f"
set completion-group-bg          "#f6d5c9"
set completion-group-fg          "#94442c"

# Notifications
set notification-bg              "#f6d5c9"
set notification-fg              "#181811"
set notification-error-bg        "#f6d5c9"
set notification-error-fg        "#b01319"
set notification-warning-bg      "#f6d5c9"
set notification-warning-fg      "#965b23"
