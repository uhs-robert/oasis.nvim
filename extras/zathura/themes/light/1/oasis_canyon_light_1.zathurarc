# extras/zathura/oasis_canyon_light_1.zathurarc
## name: Oasis Canyon Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#e7c3a5"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f4e3d5"
set default-fg                   "#181811"
set statusbar-bg                 "#efd7c3"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#efd7c3"
set inputbar-fg                  "#3c3c1f"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(114,174,218,0.5)"
set highlight-fg                 "#092234"

# Index (the toggle_index file listing)
set index-bg                     "#f4e3d5"
set index-fg                     "#181811"
set index-active-bg              "#e7c3a5"
set index-active-fg              "#3c3c1f"

# Render placeholder
set render-loading-bg            "#f4e3d5"
set render-loading-fg            "#786359"

# Signatures
set signature-success-color      "#295567"
set signature-warning-color      "#7d642b"
set signature-error-color        "#ad1319"

# Completion
set completion-bg                "#f4e3d5"
set completion-fg                "#181811"
set completion-highlight-bg      "#e7c3a5"
set completion-highlight-fg      "#3c3c1f"
set completion-group-bg          "#efd7c3"
set completion-group-fg          "#90442b"

# Notifications
set notification-bg              "#efd7c3"
set notification-fg              "#181811"
set notification-error-bg        "#efd7c3"
set notification-error-fg        "#ad1319"
set notification-warning-bg      "#efd7c3"
set notification-warning-fg      "#7d642b"
