# extras/zathura/oasis_starlight_light_1.zathurarc
## name: Oasis Starlight Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# On by default so the theme is visible on first open; ctrl-r restores the authored colors.
set recolor true
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#e6e1cc"
set recolor-darkcolor            "#1e1e14"

# Chrome
set default-bg                   "#faf9f5"
set default-fg                   "#1e1e14"
set statusbar-bg                 "#f2f0e6"
set statusbar-fg                 "#1e1e14"
set inputbar-bg                  "#f2f0e6"
set inputbar-fg                  "#484824"

# Search
set highlight-color              "rgba(218,207,164,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#faf9f5"
set index-fg                     "#1e1e14"
set index-active-bg              "#e6e1cc"
set index-active-fg              "#484824"

# Render placeholder
set render-loading-bg            "#faf9f5"
set render-loading-fg            "#6c747e"

# Signatures
set signature-success-color      "#306074"
set signature-warning-color      "#a46326"
set signature-error-color        "#c3151c"

# Completion
set completion-bg                "#faf9f5"
set completion-fg                "#1e1e14"
set completion-highlight-bg      "#e6e1cc"
set completion-highlight-fg      "#484824"
set completion-group-bg          "#f2f0e6"
set completion-group-fg          "#2c68a5"

# Notifications
set notification-bg              "#f2f0e6"
set notification-fg              "#1e1e14"
set notification-error-bg        "#f2f0e6"
set notification-error-fg        "#c3151c"
set notification-warning-bg      "#f2f0e6"
set notification-warning-fg      "#a46326"
