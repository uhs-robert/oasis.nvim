# extras/zathura/oasis_luna_light_1.zathurarc
## name: Oasis Luna Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#c2c2f0"
set recolor-darkcolor            "#191911"

# Chrome
set default-bg                   "#f3f3fc"
set default-fg                   "#191911"
set statusbar-bg                 "#e1e1f7"
set statusbar-fg                 "#191911"
set inputbar-bg                  "#e1e1f7"
set inputbar-fg                  "#454523"

# Search
set highlight-color              "rgba(195,161,221,0.4)"
set highlight-active-color       "rgba(209,190,122,0.5)"
set highlight-fg                 "#31290d"

# Index (the toggle_index file listing)
set index-bg                     "#f3f3fc"
set index-fg                     "#191911"
set index-active-bg              "#c2c2f0"
set index-active-fg              "#454523"

# Render placeholder
set render-loading-bg            "#f3f3fc"
set render-loading-fg            "#716d81"

# Signatures
set signature-success-color      "#2f5d70"
set signature-warning-color      "#a06125"
set signature-error-color        "#bd151b"

# Completion
set completion-bg                "#f3f3fc"
set completion-fg                "#191911"
set completion-highlight-bg      "#c2c2f0"
set completion-highlight-fg      "#454523"
set completion-group-bg          "#e1e1f7"
set completion-group-fg          "#6a6430"

# Notifications
set notification-bg              "#e1e1f7"
set notification-fg              "#191911"
set notification-error-bg        "#e1e1f7"
set notification-error-fg        "#bd151b"
set notification-warning-bg      "#e1e1f7"
set notification-warning-fg      "#a06125"
