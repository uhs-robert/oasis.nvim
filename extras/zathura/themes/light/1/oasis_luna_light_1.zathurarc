# extras/zathura/oasis_luna_light_1.zathurarc
## name: Oasis Luna Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f3f3fc"
set recolor-darkcolor            "#191911"

# Chrome
set default-bg                   "#f3f3fc"
set default-fg                   "#191911"
set statusbar-bg                 "#e1e1f7"
set statusbar-fg                 "#191911"
set inputbar-bg                  "#e1e1f7"
set inputbar-fg                  "#454523"

# Search
set highlight-color              "#c3a1dd"
set highlight-active-color       "#d1be7a"

# Completion
set completion-bg                "#f3f3fc"
set completion-fg                "#191911"
set completion-highlight-bg      "#c2c2f0"
set completion-highlight-fg      "#454523"
set completion-group-bg          "#e1e1f7"
set completion-group-fg          "#6a6430"

# Notifications
set notification-bg              "#e1e1f7"
set notification-fg              "#191911"
set notification-error-bg        "#e1e1f7"
set notification-error-fg        "#bd151b"
set notification-warning-bg      "#e1e1f7"
set notification-warning-fg      "#a06125"
