# extras/zathura/oasis_twilight_light_1.zathurarc
## name: Oasis Twilight Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#dbc7eb"
set recolor-darkcolor            "#1b1b13"

# Chrome
set default-bg                   "#f8f4fb"
set default-fg                   "#1b1b13"
set statusbar-bg                 "#ede3f5"
set statusbar-fg                 "#1b1b13"
set inputbar-bg                  "#ede3f5"
set inputbar-fg                  "#454523"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#f8f4fb"
set index-fg                     "#1b1b13"
set index-active-bg              "#dbc7eb"
set index-active-fg              "#454523"

# Render placeholder
set render-loading-bg            "#f8f4fb"
set render-loading-fg            "#746e82"

# Signatures
set signature-success-color      "#2f5e71"
set signature-warning-color      "#a26226"
set signature-error-color        "#bf151b"

# Completion
set completion-bg                "#f8f4fb"
set completion-fg                "#1b1b13"
set completion-highlight-bg      "#dbc7eb"
set completion-highlight-fg      "#454523"
set completion-group-bg          "#ede3f5"
set completion-group-fg          "#a14930"

# Notifications
set notification-bg              "#ede3f5"
set notification-fg              "#1b1b13"
set notification-error-bg        "#ede3f5"
set notification-error-fg        "#bf151b"
set notification-warning-bg      "#ede3f5"
set notification-warning-fg      "#a26226"
