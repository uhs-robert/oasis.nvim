# extras/zathura/oasis_rose_light_1.zathurarc
## name: Oasis Rose Light 1
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#faeef5"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#faeef5"
set default-fg                   "#181811"
set statusbar-bg                 "#f5dceb"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#f5dceb"
set inputbar-fg                  "#434322"

# Search
set highlight-color              "#dba3c6"
set highlight-active-color       "#72dacc"

# Completion
set completion-bg                "#faeef5"
set completion-fg                "#181811"
set completion-highlight-bg      "#ecbfd9"
set completion-highlight-fg      "#434322"
set completion-group-bg          "#f5dceb"
set completion-group-fg          "#8d4d67"

# Notifications
set notification-bg              "#f5dceb"
set notification-fg              "#181811"
set notification-error-bg        "#f5dceb"
set notification-error-fg        "#ba141b"
set notification-warning-bg      "#f5dceb"
set notification-warning-fg      "#9e6025"
