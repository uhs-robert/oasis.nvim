# extras/zathura/oasis_canyon_light_3.zathurarc
## name: Oasis Canyon Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#eed3bd"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#eed3bd"
set default-fg                   "#181811"
set statusbar-bg                 "#e9c7ab"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#e9c7ab"
set inputbar-fg                  "#33331a"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(114,174,218,0.5)"
set highlight-fg                 "#092234"

# Index (the toggle_index file listing)
set index-bg                     "#eed3bd"
set index-fg                     "#181811"
set index-active-bg              "#e1b38c"
set index-active-fg              "#33331a"

# Render placeholder
set render-loading-bg            "#eed3bd"
set render-loading-fg            "#6d5b52"

# Signatures
set signature-success-color      "#264c5b"
set signature-warning-color      "#735b27"
set signature-error-color        "#9d1116"

# Completion
set completion-bg                "#eed3bd"
set completion-fg                "#181811"
set completion-highlight-bg      "#e1b38c"
set completion-highlight-fg      "#33331a"
set completion-group-bg          "#e9c7ab"
set completion-group-fg          "#833d26"

# Notifications
set notification-bg              "#e9c7ab"
set notification-fg              "#181811"
set notification-error-bg        "#e9c7ab"
set notification-error-fg        "#9d1116"
set notification-warning-bg      "#e9c7ab"
set notification-warning-fg      "#735b27"
