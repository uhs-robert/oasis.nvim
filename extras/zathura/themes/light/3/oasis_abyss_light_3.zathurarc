# extras/zathura/oasis_abyss_light_3.zathurarc
## name: Oasis Abyss Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#b9b9b9"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#d8d8d8"
set default-fg                   "#181811"
set statusbar-bg                 "#cdcdcd"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#cdcdcd"
set inputbar-fg                  "#33331a"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#d8d8d8"
set index-fg                     "#181811"
set index-active-bg              "#b9b9b9"
set index-active-fg              "#33331a"

# Render placeholder
set render-loading-bg            "#d8d8d8"
set render-loading-fg            "#615f57"

# Signatures
set signature-success-color      "#264c5b"
set signature-warning-color      "#875221"
set signature-error-color        "#9e1116"

# Completion
set completion-bg                "#d8d8d8"
set completion-fg                "#181811"
set completion-highlight-bg      "#b9b9b9"
set completion-highlight-fg      "#33331a"
set completion-group-bg          "#cdcdcd"
set completion-group-fg          "#9a2626"

# Notifications
set notification-bg              "#cdcdcd"
set notification-fg              "#181811"
set notification-error-bg        "#cdcdcd"
set notification-error-fg        "#9e1116"
set notification-warning-bg      "#cdcdcd"
set notification-warning-fg      "#875221"
