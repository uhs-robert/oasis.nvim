# extras/zathura/oasis_twilight_light_3.zathurarc
## name: Oasis Twilight Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#ccb1e4"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#eadff4"
set default-fg                   "#181811"
set statusbar-bg                 "#dfceee"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#dfceee"
set inputbar-fg                  "#3a3a1e"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#eadff4"
set index-fg                     "#181811"
set index-active-bg              "#ccb1e4"
set index-active-fg              "#3a3a1e"

# Render placeholder
set render-loading-bg            "#eadff4"
set render-loading-fg            "#686376"

# Signatures
set signature-success-color      "#2a5364"
set signature-warning-color      "#915823"
set signature-error-color        "#aa1318"

# Completion
set completion-bg                "#eadff4"
set completion-fg                "#181811"
set completion-highlight-bg      "#ccb1e4"
set completion-highlight-fg      "#3a3a1e"
set completion-group-bg          "#dfceee"
set completion-group-fg          "#8f422a"

# Notifications
set notification-bg              "#dfceee"
set notification-fg              "#181811"
set notification-error-bg        "#dfceee"
set notification-error-fg        "#aa1318"
set notification-warning-bg      "#dfceee"
set notification-warning-fg      "#915823"
