# extras/zathura/oasis_moonlight_light_3.zathurarc
## name: Oasis Moonlight Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#d1cbb2"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#e8e5d8"
set default-fg                   "#181811"
set statusbar-bg                 "#dfdbca"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#dfdbca"
set inputbar-fg                  "#3c3c1e"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#e8e5d8"
set index-fg                     "#181811"
set index-active-bg              "#d1cbb2"
set index-active-fg              "#3c3c1e"

# Render placeholder
set render-loading-bg            "#e8e5d8"
set render-loading-fg            "#5e6870"

# Signatures
set signature-success-color      "#2a5465"
set signature-warning-color      "#935924"
set signature-error-color        "#ac1318"

# Completion
set completion-bg                "#e8e5d8"
set completion-fg                "#181811"
set completion-highlight-bg      "#d1cbb2"
set completion-highlight-fg      "#3c3c1e"
set completion-group-bg          "#dfdbca"
set completion-group-fg          "#465c72"

# Notifications
set notification-bg              "#dfdbca"
set notification-fg              "#181811"
set notification-error-bg        "#dfdbca"
set notification-error-fg        "#ac1318"
set notification-warning-bg      "#dfdbca"
set notification-warning-fg      "#935924"
