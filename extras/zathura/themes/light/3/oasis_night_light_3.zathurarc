# extras/zathura/oasis_night_light_3.zathurarc
## name: Oasis Night Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#d1e2f5"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#d1e2f5"
set default-fg                   "#181811"
set statusbar-bg                 "#bed6f1"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#bed6f1"
set inputbar-fg                  "#39391d"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(221,111,111,0.5)"
set highlight-fg                 "#350808"

# Index (the toggle_index file listing)
set index-bg                     "#d1e2f5"
set index-fg                     "#181811"
set index-active-bg              "#9ec2eb"
set index-active-fg              "#39391d"

# Render placeholder
set render-loading-bg            "#d1e2f5"
set render-loading-fg            "#5c656e"

# Signatures
set signature-success-color      "#285162"
set signature-warning-color      "#8e5723"
set signature-error-color        "#a71217"

# Completion
set completion-bg                "#d1e2f5"
set completion-fg                "#181811"
set completion-highlight-bg      "#9ec2eb"
set completion-highlight-fg      "#39391d"
set completion-group-bg          "#bed6f1"
set completion-group-fg          "#43596e"

# Notifications
set notification-bg              "#bed6f1"
set notification-fg              "#181811"
set notification-error-bg        "#bed6f1"
set notification-error-fg        "#a71217"
set notification-warning-bg      "#bed6f1"
set notification-warning-fg      "#8e5723"
