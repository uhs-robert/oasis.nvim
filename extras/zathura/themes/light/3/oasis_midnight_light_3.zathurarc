# extras/zathura/oasis_midnight_light_3.zathurarc
## name: Oasis Midnight Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#b3bdd1"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#d9dee8"
set default-fg                   "#181811"
set statusbar-bg                 "#cbd2df"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#cbd2df"
set inputbar-fg                  "#37371c"

# Search
set highlight-color              "rgba(225,201,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#d9dee8"
set index-fg                     "#181811"
set index-active-bg              "#b3bdd1"
set index-active-fg              "#37371c"

# Render placeholder
set render-loading-bg            "#d9dee8"
set render-loading-fg            "#5a646b"

# Signatures
set signature-success-color      "#285060"
set signature-warning-color      "#8d5522"
set signature-error-color        "#a41217"

# Completion
set completion-bg                "#d9dee8"
set completion-fg                "#181811"
set completion-highlight-bg      "#b3bdd1"
set completion-highlight-fg      "#37371c"
set completion-group-bg          "#cbd2df"
set completion-group-fg          "#a12727"

# Notifications
set notification-bg              "#cbd2df"
set notification-fg              "#181811"
set notification-error-bg        "#cbd2df"
set notification-error-fg        "#a41217"
set notification-warning-bg      "#cbd2df"
set notification-warning-fg      "#8d5522"
