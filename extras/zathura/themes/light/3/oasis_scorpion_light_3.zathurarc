# extras/zathura/oasis_scorpion_light_3.zathurarc
## name: Oasis Scorpion Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#f4cfc3"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f4cfc3"
set default-fg                   "#181811"
set statusbar-bg                 "#f0bfb0"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#f0bfb0"
set inputbar-fg                  "#33331a"

# Search
set highlight-color              "rgba(225,182,157,0.4)"
set highlight-active-color       "rgba(185,209,122,0.5)"
set highlight-fg                 "#26310d"

# Index (the toggle_index file listing)
set index-bg                     "#f4cfc3"
set index-fg                     "#181811"
set index-active-bg              "#eba68f"
set index-active-fg              "#33331a"

# Render placeholder
set render-loading-bg            "#f4cfc3"
set render-loading-fg            "#695b58"

# Signatures
set signature-success-color      "#264b5a"
set signature-warning-color      "#865221"
set signature-error-color        "#9c1116"

# Completion
set completion-bg                "#f4cfc3"
set completion-fg                "#181811"
set completion-highlight-bg      "#eba68f"
set completion-highlight-fg      "#33331a"
set completion-group-bg          "#f0bfb0"
set completion-group-fg          "#833c27"

# Notifications
set notification-bg              "#f0bfb0"
set notification-fg              "#181811"
set notification-error-bg        "#f0bfb0"
set notification-error-fg        "#9c1116"
set notification-warning-bg      "#f0bfb0"
set notification-warning-fg      "#865221"
