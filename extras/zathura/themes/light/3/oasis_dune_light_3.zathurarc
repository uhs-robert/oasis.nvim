# extras/zathura/oasis_dune_light_3.zathurarc
## name: Oasis Dune Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f7e9d4"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f7e9d4"
set default-fg                   "#181811"
set statusbar-bg                 "#f3dfc1"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#f3dfc1"
set inputbar-fg                  "#3f3f20"

# Search
set highlight-color              "#e1c99d"
set highlight-active-color       "#b9d17a"

# Completion
set completion-bg                "#f7e9d4"
set completion-fg                "#181811"
set completion-highlight-bg      "#edcfa0"
set completion-highlight-fg      "#3f3f20"
set completion-group-bg          "#f3dfc1"
set completion-group-fg          "#635e3a"

# Notifications
set notification-bg              "#f3dfc1"
set notification-fg              "#181811"
set notification-error-bg        "#f3dfc1"
set notification-error-fg        "#b31419"
set notification-warning-bg      "#f3dfc1"
set notification-warning-fg      "#985c25"
