# extras/zathura/oasis_mirage_light_3.zathurarc
## name: Oasis Mirage Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#d8f2ef"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#d8f2ef"
set default-fg                   "#181811"
set statusbar-bg                 "#c7ece8"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#c7ece8"
set inputbar-fg                  "#404021"

# Search
set highlight-color              "#9fe0d7"
set highlight-active-color       "#dd986f"

# Completion
set completion-bg                "#d8f2ef"
set completion-fg                "#181811"
set completion-highlight-bg      "#aae3dc"
set completion-highlight-fg      "#404021"
set completion-group-bg          "#c7ece8"
set completion-group-fg          "#42655b"

# Notifications
set notification-bg              "#c7ece8"
set notification-fg              "#181811"
set notification-error-bg        "#c7ece8"
set notification-error-fg        "#b51419"
set notification-warning-bg      "#c7ece8"
set notification-warning-fg      "#995d25"
