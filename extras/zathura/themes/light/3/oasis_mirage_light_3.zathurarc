# extras/zathura/oasis_mirage_light_3.zathurarc
## name: Oasis Mirage Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
# The page sits on surface so it reads as paper against the window background.
set recolor-lightcolor           "#aae3dc"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#d8f2ef"
set default-fg                   "#181811"
set statusbar-bg                 "#c7ece8"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#c7ece8"
set inputbar-fg                  "#404021"

# Search
set highlight-color              "rgba(159,224,215,0.4)"
set highlight-active-color       "rgba(221,152,111,0.5)"
set highlight-fg                 "#351908"

# Index (the toggle_index file listing)
set index-bg                     "#d8f2ef"
set index-fg                     "#181811"
set index-active-bg              "#aae3dc"
set index-active-fg              "#404021"

# Render placeholder
set render-loading-bg            "#d8f2ef"
set render-loading-fg            "#606e6d"

# Signatures
set signature-success-color      "#2c596b"
set signature-warning-color      "#995d25"
set signature-error-color        "#b51419"

# Completion
set completion-bg                "#d8f2ef"
set completion-fg                "#181811"
set completion-highlight-bg      "#aae3dc"
set completion-highlight-fg      "#404021"
set completion-group-bg          "#c7ece8"
set completion-group-fg          "#42655b"

# Notifications
set notification-bg              "#c7ece8"
set notification-fg              "#181811"
set notification-error-bg        "#c7ece8"
set notification-error-fg        "#b51419"
set notification-warning-bg      "#c7ece8"
set notification-warning-fg      "#995d25"
