# extras/zathura/oasis_cactus_light_3.zathurarc
## name: Oasis Cactus Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor.
# Left off so documents render as authored; toggle it with ctrl-r.
set recolor false
set recolor-keephue true
set recolor-lightcolor           "#dcefe3"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#dcefe3"
set default-fg                   "#181811"
set statusbar-bg                 "#cce8d6"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#cce8d6"
set inputbar-fg                  "#3f3f20"

# Search
set highlight-color              "rgba(164,218,192,0.4)"
set highlight-active-color       "rgba(188,118,214,0.5)"
set highlight-fg                 "#280b32"

# Index (the toggle_index file listing)
set index-bg                     "#dcefe3"
set index-fg                     "#181811"
set index-active-bg              "#b2dcc1"
set index-active-fg              "#3f3f20"

# Render placeholder
set render-loading-bg            "#dcefe3"
set render-loading-fg            "#616d64"

# Signatures
set signature-success-color      "#2c5769"
set signature-warning-color      "#985c25"
set signature-error-color        "#b31319"

# Completion
set completion-bg                "#dcefe3"
set completion-fg                "#181811"
set completion-highlight-bg      "#b2dcc1"
set completion-highlight-fg      "#3f3f20"
set completion-group-bg          "#cce8d6"
set completion-group-fg          "#49634a"

# Notifications
set notification-bg              "#cce8d6"
set notification-fg              "#181811"
set notification-error-bg        "#cce8d6"
set notification-error-fg        "#b31319"
set notification-warning-bg      "#cce8d6"
set notification-warning-fg      "#985c25"
