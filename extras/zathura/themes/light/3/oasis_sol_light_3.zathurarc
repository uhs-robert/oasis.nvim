# extras/zathura/oasis_sol_light_3.zathurarc
## name: Oasis Sol Light 3
## author: uhs-robert

# Recolor: zathura maps white to lightcolor and black to darkcolor
set recolor true
set recolor-keephue true
set recolor-lightcolor           "#f2c4c4"
set recolor-darkcolor            "#181811"

# Chrome
set default-bg                   "#f2c4c4"
set default-fg                   "#181811"
set statusbar-bg                 "#eeb1b1"
set statusbar-fg                 "#181811"
set inputbar-bg                  "#eeb1b1"
set inputbar-fg                  "#2d2d17"

# Search
set highlight-color              "#e19d9d"
set highlight-active-color       "#7ad1a7"

# Completion
set completion-bg                "#f2c4c4"
set completion-fg                "#181811"
set completion-highlight-bg      "#e79292"
set completion-highlight-fg      "#2d2d17"
set completion-group-bg          "#eeb1b1"
set completion-group-fg          "#902323"

# Notifications
set notification-bg              "#eeb1b1"
set notification-fg              "#181811"
set notification-error-bg        "#eeb1b1"
set notification-error-fg        "#5f440a"
set notification-warning-bg      "#eeb1b1"
set notification-warning-fg      "#7f4d1f"
